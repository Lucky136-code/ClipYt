{
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/static/:path*",
      "destination": "/frontend/:path*"
    },
    {
      "source": "/background-blur.jpg",
      "destination": "/frontend/background-blur.jpg"
    },
    {
      "source": "/api/:path*",
      "destination": "https://patrol-sign-lace-cdna.trycloudflare.com/api/:path*"
    }
  ]
}
