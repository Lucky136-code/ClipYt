{
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/frontend/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/frontend/sitemap.xml"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/static/:path*",
      "destination": "/frontend/:path*"
    },
    {
      "source": "/background-blur.jpg",
      "destination": "/frontend/background-blur.jpg"
    },
    {
      "source": "/bihari.png",
      "destination": "/frontend/bihari.png"
    },
    {
      "source": "/bihari.jpg",
      "destination": "/frontend/bihari.jpg"
    },
    {
      "source": "/mobilebackground.png",
      "destination": "/frontend/mobilebackground.png"
    },
    {
      "source": "/api/:path*",
      "destination": "https://surgeons-ordinary-obituaries-customize.trycloudflare.com/api/:path*"
    }
  ]
}
