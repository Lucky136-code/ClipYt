{
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/static/:path*",
      "destination": "/frontend/:path*"
    },
    {
      "source": "/background-blur.jpg",
      "destination": "/frontend/background-blur.jpg"
    },
    {
      "source": "/bihari.png",
      "destination": "/frontend/bihari.png"
    },
    {
      "source": "/bihari.jpg",
      "destination": "/frontend/bihari.jpg"
    },
    {
      "source": "/mobilebackground.png",
      "destination": "/frontend/mobilebackground.png"
    },
    {
      "source": "/api/:path*",
      "destination": "https://past-msgstr-wallace-providing.trycloudflare.com/api/:path*"
    }
  ]
}
